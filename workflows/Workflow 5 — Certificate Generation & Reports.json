    {
      "parameters": {
        "jsCode": "const records = items.map(item => item.json);\n\nconst totalStudents = records.length;\nconst passCount = records.filter(r => r.result === 'Pass').length;\nconst failCount = records.filter(r => r.result === 'Fail').length;\nconst passRate = totalStudents > 0 ? Math.round((passCount / totalStudents) * 10000) / 100 : 0;\n\nconst avgGradeOverall = totalStudents > 0\n  ? Math.round((records.reduce((sum, r) => sum + Number(r.average_grade), 0) / totalStudents) * 100) / 100\n  : 0;\n\nreturn [{\n  json: {\n    total_students: totalStudents,\n    passed: passCount,\n    failed: failCount,\n    pass_rate_percent: passRate,\n    overall_average_grade: avgGradeOverall,\n    report_date: new Date().toISOString().split('T')[0]\n  }\n}];"
      },
