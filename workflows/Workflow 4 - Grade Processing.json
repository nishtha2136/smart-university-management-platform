    {
      "parameters": {
        "jsCode": "const records = items.map(item => item.json);\nconst studentMap = {};\n\nfor (const rec of records) {\n  // Only consider graded assignments\n  if (rec.status !== 'graded') continue;\n  \n  const email = rec.student_email;\n  if (!studentMap[email]) {\n    studentMap[email] = { total: 0, count: 0, course: rec.course };\n  }\n  studentMap[email].total += Number(rec.final_grade);\n  studentMap[email].count += 1;\n}\n\nconst results = [];\nfor (const email in studentMap) {\n  const data = studentMap[email];\n  const average = data.total / data.count;\n  const passOrFail = average >= 4 ? 'Pass' : 'Fail'; // 4/10 average = 40%, adjust threshold as needed\n\n  results.push({\n    json: {\n      student_email: email,\n      course: data.course,\n      average_grade: Math.round(average * 100) / 100,\n      result: passOrFail\n    }\n  });\n}\n\nreturn results;"
      },
