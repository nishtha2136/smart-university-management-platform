    {
      "parameters": {
        "jsCode": "// Group attendance records by student\nconst records = items.map(item => item.json);\nconst studentMap = {};\n\nfor (const rec of records) {\n  const email = rec.student_email;\n  if (!studentMap[email]) {\n    studentMap[email] = { total: 0, present: 0, course: rec.course };\n  }\n  studentMap[email].total += 1;\n  if (rec.status === 'Present') {\n    studentMap[email].present += 1;\n  }\n}\n\n// Calculate percentage and build output\nconst results = [];\nfor (const email in studentMap) {\n  const data = studentMap[email];\n  const percentage = (data.present / data.total) * 100;\n  results.push({\n    json: {\n      student_email: email,\n      course: data.course,\n      total_days: data.total,\n      present_days: data.present,\n      attendance_percentage: Math.round(percentage * 100) / 100\n    }\n  });\n}\n\nreturn results;"
      },
